# ==============================================================================
# FactLens Configuration Environment Variables
# ==============================================================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database Configuration
DATABASE_URL=sqlite:///./data/factlens.db

# Storage Directories
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store

# Configurable LLM Provider
# Options: "openai", "gemini", "anthropic", "ollama", "mock"
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
LLM_API_KEY=your_gemini_api_key_here
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# Alternative LLM Provider Examples (Uncomment to use)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=your_openai_api_key_here

# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# OLLAMA_BASE_URL=http://localhost:11434

# Embedding / Vector Store Configuration
# Options: "sentence-transformers", "gemini", "openai", "fastembed"
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DB_TYPE=chroma

# Extraction & Comparison Settings
MAX_FACTS_PER_PAGE=15
SIMILARITY_THRESHOLD=0.75
ENABLE_BOUNDING_BOX_EXTRACTION=true
